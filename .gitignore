# ============================================
# AgriSmart .gitignore
# ============================================

# Environment & Secrets
.env
.env.local
.env.*.local
.env.prod
*.pem
*.key
*.cert

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-workspace
.project
.classpath
*.c9/

# Dependencies
vendor/
venv/
env/
env/*
node_modules/
.npm

# Build & Compilation
dist/
build/
*.pyc
__pycache__/
*.so
*.egg-info/

# Logs & Temporary Files
*.log
logs/
storage/logs/
*.tmp
.tmp/

# Database & Backups
*.sql
!sql/9_add_users_updated_at.sql
*.sql.gz
*.bak
*.backup
database/backups/

# ML Models (too large)
ml/models/*.joblib
ml/models/*.pkl
ml/data/*.csv

# ML persisted models (regenerated by the scripts on demand)
ML/**/*.pkl
ML/**/*.joblib
server/ml/models/**/*.joblib
server/ml/models/**/adapter_model.*
server/ml/models/**/adapter_config.json
server/ml/models/**/checkpoint-*/

# User Uploads
public/uploads/
uploads/
storage/uploads/

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# Docker
.dockerignore
docker-compose.override.yml
docker-compose.prod.yml

# Composer
composer.phar
composer.lock

# Node
package-lock.json
yarn.lock

# Python
requirements-lock.txt
pipenv.lock
poetry.lock

# Test Coverage
coverage/
.coverage
*.cover

# Docker volumes
postgres_data/
mysql_data/
mongo_data/

# Stripe test files
stripe_test_*.php

# Session files (if stored as files)
sessions/
session_tmp/

# Mail exports
mail_exports/

# Config overrides
config/local.php
config/testing.php

# IDE-specific
.vscode/settings.json
.idea/workspace.xml
.idea/tasks.xml
.idea/workspace.xml.*

# System
.env.swp
.htaccess.bak
.nginx.conf.bak

# Temporary test databases
test_database.db
test_*.sqlite

# Cache files
.cache/
cache/
*.cache

# Built assets (if applicable)
public/js/*.min.js
public/css/*.min.css

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb_checkpoints

# MLflow
mlruns/
.mlflow/

# Datasets
data/raw/
data/processed/
*.tar.gz
.vercel
