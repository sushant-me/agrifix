# ============================================
# AgriSmart Environment Configuration
# ============================================
# Copy this file to .env and update values
# Keep .env out of version control!
# ============================================

# Application Configuration
APP_ENV=development          # development, staging, production
APP_DEBUG=true              # true for development, false for production
APP_URL=http://localhost:8035

# Database Configuration (Supabase - PostgreSQL)
# Supabase Dashboard → Project Settings → Database → Connection string
# Use the "Direct connection" values (Session pooler also works with :5432 replaced by :6543)
DB_DRIVER=pgsql                 # pgsql = Supabase (PostgreSQL) | mysql = legacy local MySQL
DB_HOST=db.YOUR_PROJECT_REF.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=YOUR_SUPABASE_DATABASE_PASSWORD
DB_SSLMODE=require              # disable only for local testing

# Legacy MySQL (only used when DB_DRIVER=mysql)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=ecometrics
# DB_USER=root
# DB_PASS=root

# Khalti ePayment Configuration
# Test keys: https://test.khalti.com/dashboard/merchant/ (sandbox)
# Live keys: https://dashboard.khalti.com/ (production)
KHALTI_SECRET_KEY=test_secret_key_REPLACE_WITH_YOUR_TEST_KEY   # test_ or live_ prefixed
KHALTI_BASE_URL=https://dev.khalti.com/api/v2                  # dev.khalti.com for test, a.khalti.com for live
# KHALTI_TEST_KEY=

# Session Configuration
SESSION_LIFETIME=43200              # 12 hours in seconds
SESSION_SECURE_COOKIE=false         # true if using HTTPS
SESSION_HTTPONLY=true              # Don't allow JS access

# Email Configuration (optional)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@agrismart.local
MAIL_FROM_NAME=AgriSmart

# Logging Configuration
LOG_LEVEL=debug                     # debug, info, warning, error
LOG_CHANNEL=stack                   # single, stack, daily

# Security Keys (Generate with: openssl rand -hex 32)
ENCRYPTION_KEY=
JWT_SECRET=

# API Configuration
API_RATE_LIMIT=100                  # Requests per minute
API_TIMEOUT=30                      # Seconds

# Python ML Models Path
ML_MODELS_PATH=./ml/models
PYTHON_PATH=/usr/bin/python3

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760            # 10MB in bytes
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx

# Cache Configuration
CACHE_DRIVER=file                   # file, redis, memcached
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# CORS Configuration
CORS_ALLOWED_ORIGINS=*              # Restrict in production

# External Services
WEATHER_API_KEY=                    # If using weather service

# Ollama (local or remote; used as the offline-knowledge LLM provider)
OLLAMA_URL=http://localhost:11434   # e.g. https://your-ollama-host:11434
OLLAMA_MODEL=llama3.2               # any pulled model, e.g. llama3.2, qwen2.5, mistral
OLLAMA_TIMEOUT=60000                # ms

# Time Zone
TIMEZONE=Asia/Kolkata

# Feature Flags
ENABLE_MARKETPLACE=true
ENABLE_ML_PREDICTIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
