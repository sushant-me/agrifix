{
  "name": "agrismart",
  "version": "2.0.0",
  "private": true,
  "description": "AgriSmart - Smart agriculture platform (React + Express + PostgreSQL)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server run start",
    "preview": "npm --prefix client run preview"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}