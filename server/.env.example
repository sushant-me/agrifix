# AgriSmart Server (Express) — environment
# Prefers the repository-root .env; values here override it.
# Copy to server/.env and adjust.

PORT=4000
NODE_ENV=development

# PostgreSQL / Supabase
DB_HOST=db.YOUR_PROJECT_REF.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=YOUR_SUPABASE_DATABASE_PASSWORD
DB_SSLMODE=require

# Auth (generate with: openssl rand -hex 32)
JWT_SECRET=change-me
SESSION_LIFETIME=43200

# Khalti ePayment
KHALTI_SECRET_KEY=test_secret_key_REPLACE_WITH_YOUR_TEST_KEY
KHALTI_BASE_URL=https://dev.khalti.com/api/v2

# Email (password reset OTP)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@agrismart.local
MAIL_FROM_NAME=AgriSmart

# Weather
WEATHER_API_KEY=

# Python ML scripts
PYTHON_PATH=
# Optional inference service. Leave blank until a real model artifact is trained.
ML_SERVICE_URL=
ML_SERVICE_TIMEOUT=2500

# Optional local/remote Ollama enhancement. Leave blank on hosted deployments;
# the server uses its built-in Nepal agriculture rules without failed localhost calls.
OLLAMA_URL=
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=60000

# Client origin (used for Khalti return redirect)
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Serve the built React app from this process (production)
SERVE_CLIENT=false
CORS_ALLOWED_ORIGINS=*
API_RATE_LIMIT=300
